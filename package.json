{
  "name": "tower-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D telecom tower, power plant, 19-inch cabinet, microwave backhaul, cellular RF, and offline AI site-engineering workbench.",
  "keywords": [
    "telecom",
    "telecommunications",
    "threejs",
    "3d-simulation",
    "5g",
    "microwave-backhaul",
    "rf-engineering",
    "site-engineering"
  ],
  "homepage": "http://karanawzad.tech/Tower-Studio/",
  "bugs": {
    "url": "https://github.com/kara-nawzad/Tower-Studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kara-nawzad/Tower-Studio.git"
  },
  "license": "MIT",
  "author": {
    "name": "Kara Nawzad Hassan",
    "url": "http://karanawzad.tech/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev-server.mjs",
    "start": "node --env-file-if-exists=.env scripts/dev-server.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "three": "0.128.0"
  }
}
