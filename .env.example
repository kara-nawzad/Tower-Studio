# =============================================================================
# Tower Studio — Environment Configuration Example
# =============================================================================
# Copy this file to `.env` for local development customization:
#   cp .env.example .env
#
# Note: The browser application (index.html + src/) runs 100% locally in
# client-side JavaScript (including all Phase 07 AI Architect, RF Waveform,
# and NOC Copilot features) and requires ZERO external API keys or secrets.
# The variables below configure the local Node.js development server only.
# =============================================================================

# Network interface to bind the local dev server (`0.0.0.0` allows LAN/preview access)
HOST=0.0.0.0

# Port for `npm run dev` / `npm start`
PORT=3000

# Runtime mode (`development` or `production`)
NODE_ENV=development
